# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# Database Configuration
DATABASE_URL=sqlite:///acne_detection.db
# For production use PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost/acne_detection

# File Upload Configuration
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif

# ML Model Configuration
YOLO_MODEL_PATH=best1.pt
EFFICIENTNET_MODEL_PATH=acne_weights.pth

# CORS Configuration
CORS_ORIGINS=*

# Rate Limiting
RATE_LIMIT=200 per day,50 per hour

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/acne_detection.log

# Security
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# API Configuration
API_VERSION=v1
MAINTENANCE_MODE=false

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@acnedetection.com
